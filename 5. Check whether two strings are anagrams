using System;
class Program
{
    static void Main()
    {
        string s1 = "listen";
        string s2 = "silent";
        char[] a = s1.ToLower().ToCharArray();
        char[] b = s2.ToLower().ToCharArray();
        Array.Sort(a);
        Array.Sort(b);
        if (new string(a) == new string(b))
            Console.WriteLine("Anagram");
        else
            Console.WriteLine("Not Anagram");
    }
}


