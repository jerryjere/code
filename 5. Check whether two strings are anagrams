        Console.Write("Enter second string: ");
        string str2 = Console.ReadLine().ToLower();
        char[] a = str1.ToCharArray();
        char[] b = str2.ToCharArray();
        Array.Sort(a);
        Array.Sort(b);
        if (new string(a) == new string(b))
        {
            Console.WriteLine("Anagram");
        }
        else
        {
            Console.WriteLine("Not Anagram");
