using System;
class Program
{
    static void Main()
    {
        string str = "hello";
        for (int i = 0; i < str.Length; i++)
        {
            int count = 0;
            bool alreadyCounted = false;
            for (int j = 0; j < i; j++)
            {
                if (str[i] == str[j])
                    alreadyCounted = true;
            }
            if (alreadyCounted)
                continue;
            for (int j = 0; j < str.Length; j++)
            {
                if (str[i] == str[j])
                    count++;
            }

            Console.WriteLine(str[i] + " = " + count);
        }
    }
}




